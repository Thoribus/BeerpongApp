  "rulebookHowToActivate": "How to activate",
  "@rulebookHowToActivate": { "description": "Section label above activation steps in a rule card" },

  "rulebookAirballsTagline": "Miss out loud — your team pays the price.",
  "@rulebookAirballsTagline": { "description": "Tagline for the Airballs rule card" },

  "rulebookAirballsDescription": "An airball is a throw that misses every cup without touching anything. When a team accumulates 3 airballs in total, all players must take a penalty sip. The counter resets and keeps climbing.",
  "@rulebookAirballsDescription": { "description": "Full description for the Airballs rule" },

  "rulebookAirballsStep1": "Enable \"Airballs\" in game setup.",
  "@rulebookAirballsStep1": { "description": "Airballs activation step 1" },

  "rulebookAirballsStep2": "When a shot misses completely, tap the orange miss zone below the cups.",
  "@rulebookAirballsStep2": { "description": "Airballs activation step 2" },

  "rulebookAirballsStep3": "At every 3rd airball, a dialog prompts the penalty.",
  "@rulebookAirballsStep3": { "description": "Airballs activation step 3" },

  "rulebookAirballsTip": "The miss zone only appears when the Airballs rule is active — remember to tap it on every complete miss.",
  "@rulebookAirballsTip": { "description": "Tip for the Airballs rule" },

  "rulebookBounceTagline": "One ball, two cups — but the defense can swat it.",
  "@rulebookBounceTagline": { "description": "Tagline for the Bounce rule card" },

  "rulebookBounceDescription": "A bounce shot is a throw where the ball bounces off the table before landing in a cup. It rewards risk: a successful bounce removes the hit cup plus one additional random cup. However, the defending team is allowed to swat the ball away after the first bounce, so it can be blocked.",
  "@rulebookBounceDescription": { "description": "Full description for the Bounce rule" },

  "rulebookBounceStep1": "Enable \"Bounce\" in game setup.",
  "@rulebookBounceStep1": { "description": "Bounce activation step 1" },

  "rulebookBounceStep2": "During your turn, open the action menu (⋯) and tap \"Bounce Shot\".",
  "@rulebookBounceStep2": { "description": "Bounce activation step 2" },

  "rulebookBounceStep3": "Select who made the bounce, then tap the cup they sank.",
  "@rulebookBounceStep3": { "description": "Bounce activation step 3" },

  "rulebookBounceTip": "Bounce shots are high-risk, high-reward. Save them for when you need to close a gap quickly.",
  "@rulebookBounceTip": { "description": "Tip for the Bounce rule" },

  "rulebookPutbackTagline": "The game isn't over until the last redemption throw lands.",
  "@rulebookPutbackTagline": { "description": "Tagline for the Putback rule card" },

  "rulebookPutbackDescription": "When a team sinks the opponent's final cup, the losing side earns one redemption throw per player. If any throw lands, the last cup is restored and the game continues into overtime. Every player must attempt their throw before the result is decided.",
  "@rulebookPutbackDescription": { "description": "Full description for the Putback rule" },

  "rulebookPutbackStep1": "Enable \"Putback\" in game setup.",
  "@rulebookPutbackStep1": { "description": "Putback activation step 1" },

  "rulebookPutbackStep2": "When the last cup is sunk, the redemption dialog appears automatically.",
  "@rulebookPutbackStep2": { "description": "Putback activation step 2" },

  "rulebookPutbackStep3": "Each losing-team player takes one shot. A hit keeps the game alive.",
  "@rulebookPutbackStep3": { "description": "Putback activation step 3" },

  "rulebookPutbackTip": "If multiple redemption throws land, only one cup is restored — aim carefully.",
  "@rulebookPutbackTip": { "description": "Tip for the Putback rule" },

  "rulebookIslandTagline": "An isolated cup means a free bonus cup.",
  "@rulebookIslandTagline": { "description": "Tagline for the Island rule card" },

  "rulebookIslandDescription": "An island cup is one with no neighbours — completely surrounded by empty space. A designated shooter can call an island shot on it. If they sink it, they win that cup plus a bonus cup of their choice. A miss scores nothing and the attempt is used up.",
  "@rulebookIslandDescription": { "description": "Full description for the Island rule" },

  "rulebookIslandStep1": "Enable \"Island\" in game setup.",
  "@rulebookIslandStep1": { "description": "Island activation step 1" },

  "rulebookIslandStep2": "Tap \"Island Shot\" in the action menu and select the shooter.",
  "@rulebookIslandStep2": { "description": "Island activation step 2" },

  "rulebookIslandStep3": "Island cups glow yellow. Tap one to take the shot.",
  "@rulebookIslandStep3": { "description": "Island activation step 3" },

  "rulebookIslandStep4": "On success, pick your free bonus cup from the bottom sheet.",
  "@rulebookIslandStep4": { "description": "Island activation step 4" },

  "rulebookIslandTip": "If only one island cup exists, the shot triggers automatically after selecting the shooter — no extra tap needed.",
  "@rulebookIslandTip": { "description": "Tip for the Island rule" },

  "rulebookDeathcupTagline": "Sink the cup being drunk and the game ends instantly.",
  "@rulebookDeathcupTagline": { "description": "Tagline for the Deathcup rule card" },

  "rulebookDeathcupDescription": "When the Deathcup rule is active, each cup that has been sunk but not yet fully drunk is a live deathcup. If a player lands a ball in it while an opponent is still drinking, that team immediately loses — all remaining cups are cleared.",
  "@rulebookDeathcupDescription": { "description": "Full description for the Deathcup rule" },

  "rulebookDeathcupStep1": "Enable \"Deathcup\" in game setup.",
  "@rulebookDeathcupStep1": { "description": "Deathcup activation step 1" },

  "rulebookDeathcupStep2": "When a deathcup is sunk, open the action menu (⋯) and tap \"Deathcup\".",
  "@rulebookDeathcupStep2": { "description": "Deathcup activation step 2" },

  "rulebookDeathcupStep3": "Select the player who made the shot to trigger the instant win.",
  "@rulebookDeathcupStep3": { "description": "Deathcup activation step 3" },

  "rulebookDeathcupTip": "Keep track of which cups opponents are currently drinking — they're your highest-value targets.",
  "@rulebookDeathcupTip": { "description": "Tip for the Deathcup rule" },

  "rulebookRearrangeTagline": "Regroup scattered cups into a tighter formation.",
  "@rulebookRearrangeTagline": { "description": "Tagline for the Rearrange rule card" },

  "rulebookRearrangeDescription": "Once per game, when 6 or fewer cups remain on your side, you can call a re-rack. Cups are rearranged into a standard triangle formation, closing the gaps that make individual cups harder to hit. The re-rack can only be used once and only within the 6-cup limit.",
  "@rulebookRearrangeDescription": { "description": "Full description for the Rearrange rule" },

  "rulebookRearrangeStep1": "Enable \"Rearrange\" in game setup.",
  "@rulebookRearrangeStep1": { "description": "Rearrange activation step 1" },

  "rulebookRearrangeStep2": "When 6 or fewer cups remain, tap the re-rack button in the bottom dock bar.",
  "@rulebookRearrangeStep2": { "description": "Rearrange activation step 2" },

  "rulebookRearrangeStep3": "Cups immediately shift into a compact triangle.",
  "@rulebookRearrangeStep3": { "description": "Rearrange activation step 3" },

  "rulebookRearrangeTip": "Save your re-rack for when cups are most scattered — a tight triangle is significantly easier to aim at.",
  "@rulebookRearrangeTip": { "description": "Tip for the Rearrange rule" },


